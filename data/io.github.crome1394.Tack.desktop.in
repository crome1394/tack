[Desktop Entry]
Type=Application
Name=Tack
GenericName=Screenshot Editor
Comment=Mark up screenshots and pin them to your screen
Exec="@BINDIR@/tack" %f
Icon=io.github.crome1394.Tack
Terminal=false
StartupNotify=true
Categories=Graphics;2DGraphics;RasterGraphics;
Keywords=screenshot;annotate;markup;arrow;blur;pixelate;pin;
MimeType=image/png;image/jpeg;image/webp;image/bmp;image/tiff;image/gif;
